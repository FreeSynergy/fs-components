#!/usr/bin/env -S python3 -I
"""Gate for B-L: every visible text exists in German AND English, and no UI text is hard coded.

Usage: contract/texts-check [root] [--all] [--warn] [--selftest]. Exit 1 on any finding; `--warn` always exits 0 and prints
::warning:: annotations (R1/R2/R3 counts) plus a summary to $GITHUB_STEP_SUMMARY when set. Pattern: Facade over three small rules.
  R1  hard coded UI string: a string literal given to a call that shows it (text, label, title, tooltip, placeholder, Menu::new,
      MenuEntry::new, Status::Info/Problem, ...) in code that is not a test.
  R2  single-language table: a file named words*/labels*/lang* with UI literals (the English-only tables that move to .mf2).
  R3  `.mf2` text files (ADR 0057, Unicode MessageFormat 2, one `en.mf2` and one `de.mf2` per folder, entries `id = message`):
      every id in en AND de, the same `$variables`, no empty message, de differs from en unless the id is listed under [same]
      in contract/texts-exceptions.toml (a name, a unit). Heuristic (the variables are found by text, not by the MF2 parser);
      the exact check is `fs_components_mf2::check_pairs`, which every crate with texts runs as a test.
  Tests and examples are skipped (they use English fixtures on purpose), EXCEPT a file that says `texts-check: scan` in a comment:
      a demo or picture test that shows a window to a person in two languages (`tests/language_picture.rs`) must take every
      visible word from `.mf2` files, because a hard coded English menu word there is exactly the "mixed language" finding.
Heuristic on purpose: it finds candidates, a person judges; an accepted case goes into the exception file WITH a reason.
CI runs it as a warning until the migration of the programs is done (step 6), then it is hard."""
import os
import re
import sys
import tempfile
import tomllib

CALL = re.compile(r'\b(?:text|label|title|heading|tooltip|placeholder|button|aria_label|caption|hint|'
                  r'Menu::new|MenuEntry::new|Status::Info|Status::Problem|set_title|with_label)\s*\(\s*(?:(?:"[^"]*"|[^"(),]+),\s*)?"((?:[^"\\]|\\.)*)"')
ASSIGN = re.compile(r'=\s*(?:s\(|String::from\()?\s*"((?:[^"\\]|\\.)*)"\s*\)?\s*(?:\.into\(\)|\.to_string\(\)|\.to_owned\(\))')
LITERAL = re.compile(r'"((?:[^"\\]|\\.)*)"')
TABLE_FILE = re.compile(r'(^|/)(words|labels|lang)[^/]*\.rs$')


def is_ui(lit):
    """A literal a person reads: has a letter, and is not a path, option, id or format-only string."""
    if len(lit) < 2 or not re.search(r'[A-Za-zÀ-￿]', lit):
        return False
    if re.fullmatch(r'[a-z0-9_.\-/:]+', lit) or lit.startswith(("--", "fs-", "http", "/", "#", ".")) or "::" in lit:
        return False
    return " " in lit or lit[0].isupper()


def code_of(path):
    """The file without its test module (everything from the first `#[cfg(test)]`) and without comment lines."""
    text = open(path, encoding="utf-8", errors="replace").read()
    cut = text.find("#[cfg(test)]")
    text = text if cut < 0 else text[:cut]
    return "\n".join("" if ln.lstrip().startswith("//") else ln for ln in text.split("\n"))


def line_of(text, pos):
    return text.count("\n", 0, pos) + 1


ENTRY = re.compile(r"^([A-Za-z0-9_.\-]+)\s*=\s*(.*)$")
VARIABLE = re.compile(r"\$([A-Za-z_][\w\-.]*)")
LOCAL = re.compile(r"\.local\s+\$([A-Za-z_][\w\-.]*)")


def mf2_entries(path):
    """`id -> (line, message)` of an .mf2 file: indented lines continue the message, `#` lines and blank lines are skipped."""
    out, last = {}, None
    for n, raw in enumerate(open(path, encoding="utf-8").read().lstrip("\ufeff").split("\n"), 1):
        if raw[:1] in (" ", "\t") and raw.strip() and last:
            out[last] = (out[last][0], out[last][1] + "\n" + raw.strip())
        elif raw.strip() and not raw.startswith("#"):
            m = ENTRY.match(raw.rstrip())
            last = m.group(1) if m else None
            if m:
                out[last] = (n, m.group(2).strip())
    return out


def variables(message):
    return set(VARIABLE.findall(message)) - set(LOCAL.findall(message))


COUNT_VARIABLES = {"n", "count", "number", "total", "amount", "num"}


def counts_without_plural(message):
    """A message that talks about a number (`$count`, `$n` ...) but has no `.match`: "1 pages" is wrong in every language
    that has a singular. The exact proof is a render of n = 0, 1, 2 (`fs_components_mf2::check_counts`)."""
    return bool(variables(message) & COUNT_VARIABLES) and ".match" not in message


def check_mf2(root, same):
    problems = []
    for base, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d not in ("target", ".git", "temp")]
        langs = sorted(n[:-4] for n in names if n.endswith(".mf2"))
        if not langs:
            continue
        rel = os.path.relpath(base, root)
        for need in ("en", "de"):
            if need not in langs:
                problems.append(f"{rel}: no {need}.mf2 beside {', '.join(langs)}")
        if "en" not in langs:
            continue
        table = {lang: mf2_entries(os.path.join(base, lang + ".mf2")) for lang in langs}
        for lang, entries in table.items():
            for id_, (n, message) in entries.items():
                if not message:
                    problems.append(f"{rel}/{lang}.mf2:{n}: {id_} has no message")
                elif counts_without_plural(message):
                    problems.append(f"{rel}/{lang}.mf2:{n}: {id_} shows a number without a plural selector (.match)")
            if lang == "en":
                continue
            for id_, (n, message) in table["en"].items():
                if id_ not in entries:
                    problems.append(f"{rel}/en.mf2:{n}: {id_} is missing in {lang}.mf2")
                    continue
                if variables(message) != variables(entries[id_][1]):
                    problems.append(f"{rel}/{lang}.mf2:{entries[id_][0]}: {id_} has other variables than en")
                if message == entries[id_][1] and id_ not in same and len(message.split()) > 1:
                    problems.append(f"{rel}/{lang}.mf2:{entries[id_][0]}: {id_} equals en; translate it or list it under [same]")
            for id_, (n, _) in entries.items():
                if id_ not in table["en"]:
                    problems.append(f"{rel}/{lang}.mf2:{n}: {id_} is missing in en.mf2")
    return problems


MARKER = "texts-check: scan"


def marked_files(root):
    """Test and example files that opt in to the scan with a comment `texts-check: scan`."""
    for base, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d not in ("target", ".git", "temp", "contract")]
        if not {"tests", "examples"} & set(base.split(os.sep)):
            continue
        for n in names:
            path = os.path.join(base, n)
            if n.endswith(".rs") and MARKER in open(path, encoding="utf-8", errors="replace").read():
                yield path


def files(root):
    for base, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d not in ("target", ".git", "tests", "examples", "temp", "contract", "todo")]
        for n in names:
            if n.endswith(".rs"):
                yield os.path.join(base, n)


def run(root, exc):
    r1, r2 = [], []
    lits = set(exc.get("literal", {}))
    marked = set(marked_files(root))
    for path in [*files(root), *marked]:
        rel = os.path.relpath(path, root)
        text = code_of(path)
        for rx in (CALL, ASSIGN):
            for m in rx.finditer(text):
                if is_ui(m.group(1)) and f"{rel}:{m.group(1)}" not in lits:
                    r1.append(f"{rel}:{line_of(text, m.start())}: hard coded UI text {m.group(1)!r}")
        if TABLE_FILE.search(rel) and path not in marked:  # a marked test names its expectations; R1 judges it
            for m in LITERAL.finditer(text):
                if is_ui(m.group(1)) and f"{rel}:{m.group(1)}" not in lits:
                    r2.append(f"{rel}:{line_of(text, m.start())}: literal in a text table file {m.group(1)!r}")
    r3 = check_mf2(root, set(exc.get("same", {})))
    return [("R1 no hard coded UI text", r1), ("R2 no single-language table", r2), ("R3 every text in en and de (.mf2)", r3)]


def load_exceptions(root):
    path = os.path.join(root, "contract", "texts-exceptions.toml")
    if not os.path.exists(path):
        return {}
    with open(path, "rb") as f:
        return tomllib.load(f)


def selftest():
    """Mutation check: a good tree passes, and each bad file is found by exactly the rule that is meant."""
    ok = {"en.mf2": "a = Reload {$name}\nb =\n  .input {$n :number}\n  .match $n one {{{$n} x}} * {{{$n} xs}}\n",
          "de.mf2": "a = Neu laden {$name}\nb =\n  .input {$n :number}\n  .match $n one {{{$n} y}} * {{{$n} ys}}\n"}
    rs = lambda src: {"crates/x/src/f.rs": src}
    cases = {
        "good": ({"crates/x/texts/" + k: v for k, v in ok.items()}, (0, 0, 0)),
        "bad_call": (rs('fn f() { text("Reload the catalog"); }\n'), (1, 0, 0)),
        "menu": (rs('fn f() { MenuEntry::new("open", "Open the file"); }\n'), (1, 0, 0)),
        "demo_marked": ({"crates/x/tests/demo.rs": '// texts-check: scan\nfn f() { MenuEntry::new("tiles", "Tiles"); }\n'}, (1, 0, 0)),
        "demo_unmarked": ({"crates/x/tests/demo.rs": 'fn f() { MenuEntry::new("tiles", "Tiles"); }\n'}, (0, 0, 0)),
        "demo_marked_clean": ({"crates/x/tests/demo.rs": '// texts-check: scan\nfn f() { MenuEntry::new("tiles", texts.plain("demo-tiles")); }\n'}, (0, 0, 0)),
        "demo_marked_lang_file": ({"crates/x/tests/language_demo.rs": '// texts-check: scan\nfn t() { assert_eq!(labels(), "Tiles"); }\n'}, (0, 0, 0)),
        "words_table": ({"crates/x/src/words.rs": 'pub const X: &str = "Install now";\n'}, (0, 1, 0)),
        "test_module": (rs('fn f() {}\n#[cfg(test)]\nmod t { fn g() { text("Only a test text"); } }\n'), (0, 0, 0)),
        "no_de": ({"t/en.mf2": "a = Reload\n"}, (0, 0, 1)),
        "no_en": ({"t/de.mf2": "a = Neu laden\n"}, (0, 0, 1)),
        "id_only_en": ({"t/en.mf2": "a = A\nb = B\n", "t/de.mf2": "a = A\n"}, (0, 0, 1)),
        "id_only_de": ({"t/en.mf2": "a = A\n", "t/de.mf2": "a = A\nb = B\n"}, (0, 0, 1)),
        "variable": ({"t/en.mf2": "a = Hello {$name}\n", "t/de.mf2": "a = Hallo {$other}\n"}, (0, 0, 1)),
        # "1 pages": a count in a message without `.match` is found in each language file (finding W3, 2026-11-14)
        "count_no_plural": ({"t/en.mf2": "a = {$count} pages\n", "t/de.mf2": "a = {$count} Seiten\n"}, (0, 0, 2)),
        "count_with_plural": ({"t/en.mf2": "a =\n  .input {$count :number}\n  .match $count one {{{$count} page}} * {{{$count} pages}}\n",
                               "t/de.mf2": "a =\n  .input {$count :number}\n  .match $count one {{{$count} Seite}} * {{{$count} Seiten}}\n"}, (0, 0, 0)),
        "same_text": ({"t/en.mf2": "a = Not translated\n", "t/de.mf2": "a = Not translated\n"}, (0, 0, 1)),
        "empty": ({"t/en.mf2": "a = A\n", "t/de.mf2": "a =\n"}, (0, 0, 1)),
    }
    bad = 0
    for name, (tree, want) in cases.items():
        with tempfile.TemporaryDirectory() as d:
            for rel, text in tree.items():
                os.makedirs(os.path.dirname(os.path.join(d, rel)), exist_ok=True)
                with open(os.path.join(d, rel), "w", encoding="utf-8") as f:
                    f.write(text)
            got = tuple(len(p) for _, p in run(d, {}))
        print(("ok   " if got == want else "FAIL ") + f"selftest {name}: found {got}, wanted {want}")
        bad += got != want
    return 1 if bad else 0


def esc(text):
    """Workflow-command escaping of an annotation message: `%`, CR and LF."""
    return text.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")


def warn_lines(results):
    """GitHub annotations: one `::warning::` per rule with findings (the first three as examples), and a total line."""
    out = []
    for i, (title, problems) in enumerate(results, 1):
        if problems:
            out.append(f"::warning title=texts-check R{i}::{title}: {len(problems)} findings, e.g. " + esc(" | ".join(problems[:3])))
    out.append("::notice title=texts-check::findings R1/R2/R3 = " + "/".join(str(len(p)) for _, p in results))
    return out


def selftest_warn():
    """`--warn` exits 0 with a finding and prints one annotation for the rule; without a finding only the notice."""
    with tempfile.TemporaryDirectory() as d:
        os.makedirs(os.path.join(d, "crates/x/src"))
        with open(os.path.join(d, "crates/x/src/f.rs"), "w", encoding="utf-8") as f:
            f.write('fn f() { text("Reload the catalog"); }\n')
        results = run(d, {})
    lines = warn_lines(results)
    good = sum(l.startswith("::warning title=texts-check R1") for l in lines) == 1 and lines[-1].endswith("= 1/0/0")
    clean = warn_lines([("R1", []), ("R2", []), ("R3", [])]) == ["::notice title=texts-check::findings R1/R2/R3 = 0/0/0"]
    escaped = esc("50%\nx\r") == "50%25%0Ax%0D" and "%250A" in "".join(warn_lines([("R1", ["a %0A b\nc"])]))
    print(("ok   " if good and clean and escaped else "FAIL ") + "selftest warn: annotations and escape")
    return 0 if good and clean and escaped else 1


def main(argv):
    if "--selftest" in argv:
        return selftest() | selftest_warn()
    args = [a for a in argv if not a.startswith("--")]
    root = os.path.abspath(args[0] if args else os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
    results = run(root, load_exceptions(root))
    total = 0
    for title, problems in results:
        total += len(problems)
        print(("FAIL " if problems else "ok   ") + f"{title} ({len(problems)})")
        for line in problems[: (10 ** 6 if "--all" in argv else 5)]:
            print("     " + line)
    print(f"findings: {total}")
    if "--warn" in argv:
        lines = warn_lines(results)
        print("\n".join(lines))
        if os.environ.get("GITHUB_STEP_SUMMARY"):
            with open(os.environ["GITHUB_STEP_SUMMARY"], "a", encoding="utf-8") as f:
                f.write("### texts-check (warning only)\n" + "\n".join(f"- {t}: {len(p)}" for t, p in results) + "\n")
        return 0
    return 1 if total else 0


sys.exit(main(sys.argv[1:]))
